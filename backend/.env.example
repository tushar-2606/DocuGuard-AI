# Copy to backend/.env and fill in values. Never commit real secrets.

# development | production
ENVIRONMENT=development

# Required in production. Must be a long random string.
JWT_SECRET_KEY=replace-with-a-secure-random-secret

JWT_ALGORITHM=HS256

# Default: 7 days. Consider shorter values in production.
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Local default (SQLite). For PostgreSQL use:
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/docuguard
DATABASE_URL=sqlite:///./docuguard.db

# Comma-separated browser origins allowed to call the API with credentials.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

MAX_UPLOAD_BYTES=15728640
MAX_PDF_PAGES=100

AUTH_RATE_LIMIT_PER_MINUTE=20
UPLOAD_RATE_LIMIT_PER_MINUTE=10
# Comma-separated trusted proxy CIDRs; leave empty unless the API is behind trusted proxies.
TRUSTED_PROXY_CIDRS=
MIN_PASSWORD_LENGTH=8

# Reminder scheduler (IANA timezone; examples: UTC, Europe/London, America/New_York)
APP_TIMEZONE=UTC
DEFAULT_DATE_ONLY_REMINDER_TIME=09:00
REMINDER_CHECK_INTERVAL_SECONDS=60
ENABLE_REMINDER_SCHEDULER=true

# Optional real SMTP delivery. Leave unset to use in-app reminders only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
